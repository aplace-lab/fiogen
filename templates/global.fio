[global]
ioengine=psync
rw=write
direct=0
fsync_on_close={{FSYNC}}
create_on_open=1
unlink_each_loop=1
file_service_type=sequential
openfiles=1
filename_format=$jobnum.$filenum
loops=1000000
time_based=1
thread=1
group_reporting=1
new_group=1
per_job_logs=0
log_avg_msec=1000
runtime={{RUNTIME}}
ramp_time={{RAMP}}